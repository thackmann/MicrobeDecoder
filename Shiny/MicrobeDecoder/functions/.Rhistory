# app.R
library(shiny)
library(later)
# --- helpers for buttons ---
start_button <- function(id = "start", label = "Start") {
actionButton(id, label, class = "btn btn-primary")
}
stop_button <- function(id = "stop", label = "Stop") {
actionButton(id, label, class = "btn btn-danger", style = "margin-left:8px;")
}
# --- helpers for loop control ---
append_log <- function(session, msg) {
old <- isolate(session$userData$logText())
session$userData$logText(paste0(old, msg, "\n"))
}
check_stop <- function(session, i, t0) {
if (!isTRUE(isolate(session$userData$start()))) return(TRUE)
if (isTRUE(isolate(session$userData$stop()))) {
elapsed <- round(as.numeric(difftime(Sys.time(), t0, units = "secs")), 2)
append_log(session, sprintf("Stopped at batch %d (%.2f s). π≈%.6f (n=%s)",
i,
elapsed,
4 * isolate(session$userData$calc()$hits) /
max(1, isolate(session$userData$calc()$n)),
format(isolate(session$userData$calc()$n), big.mark=",")))
session$userData$start(FALSE)
return(TRUE)
}
FALSE
}
ui <- fluidPage(
titlePanel("Interruptible Monte Carlo π (session-based)"),
fluidRow(
column(4, start_button(), stop_button()),
column(8, verbatimTextOutput("log", placeholder = TRUE))
)
)
server <- function(input, output, session) {
# --- state
session$userData$logText <- reactiveVal("Ready. Press Start.\n")
session$userData$start   <- reactiveVal(FALSE)
session$userData$stop    <- reactiveVal(FALSE)
# calc state: list(hits, n, target, batch)
session$userData$calc    <- reactiveVal(list(hits = 0L, n = 0L, target = 0L, batch = 0L))
output$log <- renderText(session$userData$logText())
run_loop <- function(i = 1L, t0 = Sys.time()) {
if (check_stop(session, i, t0)) return(invisible())
st <- isolate(session$userData$calc())
if (st$n >= st$target) {
# done
pi_est <- 4 * st$hits / st$n
elapsed <- round(as.numeric(difftime(Sys.time(), t0, units = "secs")), 2)
append_log(session, sprintf("Done. π≈%.6f   (n=%s in %.2f s)",
pi_est, format(st$n, big.mark=","), elapsed))
session$userData$start(FALSE)
return(invisible())
}
# ---- real calculation: one batch of random points
# Keep each chunk quick to maintain responsiveness
x <- runif(st$batch)
y <- runif(st$batch)
hits <- sum(x*x + y*y <= 1)
st$hits <- st$hits + hits
st$n    <- st$n + st$batch
session$userData$calc(st)
# Log occasionally (every 10 batches)
if (i %% 10 == 0L || st$n >= st$target) {
pi_est <- 4 * st$hits / st$n
append_log(session, sprintf("Batch %d — π≈%.6f (n=%s)",
i, pi_est, format(st$n, big.mark=",")))
}
# schedule next batch
later::later(function() run_loop(i + 1L, t0), delay = 0.01)
}
observeEvent(input$start, {
# configure the run (tune these):
target_samples <- 2e6L   # total points to draw
batch_size     <- 5e4L   # per-iteration chunk (keep reasonably small)
session$userData$calc(list(hits = 0L, n = 0L,
target = as.integer(target_samples),
batch  = as.integer(batch_size)))
session$userData$stop(FALSE)
session$userData$start(TRUE)
session$userData$logText("Running Monte Carlo π…\n")
run_loop(1L, Sys.time())
})
observeEvent(input$stop, {
session$userData$stop(TRUE)
})
}
shinyApp(ui, server)
