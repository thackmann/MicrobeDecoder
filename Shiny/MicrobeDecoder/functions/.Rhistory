"
),
br(), br(),
checkboxInput("chatty", "Extra chatty debug", TRUE)
),
column(
8,
h4("Log"),
verbatimTextOutput("log", placeholder = TRUE)
)
),
tags$script(HTML("Shiny && (Shiny.options.debug = true);"))
)
server <- function(input, output, session) {
logText <- reactiveVal("Ready. Press Start.\n")
append_log <- function(...) {
msg <- paste0(format(Sys.time(), "%H:%M:%S"), " | ", paste0(..., collapse = ""), "\n")
# IMPORTANT: read reactiveVal with isolate() outside reactive context
current <- isolate(logText())
logText(paste0(current, msg))
message(msg)
}
output$log <- renderText(logText())
running <- reactiveVal(FALSE)
observeEvent(input$interrupt, {
append_log(sprintf("SERVER saw interrupt = %s", input$interrupt))
}, ignoreInit = TRUE)
run_loop <- function(i = 1L, start_time = Sys.time()) {
# Read reactive state via isolate() since we're outside a reactive context
if (!isTRUE(isolate(running()))) return(invisible())
# Check interrupt before doing work
if (isTRUE(isolate(input$interrupt))) {
append_log(sprintf("Iter %03d: interrupt==TRUE -> STOP", i))
running(FALSE)
elapsed <- round(as.numeric(difftime(Sys.time(), start_time, units = "secs")), 2)
append_log(sprintf("Calculation INTERRUPTED after %.2f sec.", elapsed))
return(invisible())
}
if (isTRUE(isolate(input$chatty))) append_log(sprintf("Iter %03d: work begin", i))
# (Do a little work here; avoid Sys.sleep in long chunks)
# ... your CPU work ...
if (isTRUE(isolate(input$chatty))) append_log(sprintf("Iter %03d: done; will schedule next", i))
# Schedule next iteration, keeping UI responsive
later::later(function() run_loop(i + 1L, start_time), delay = 0.2)
}
observeEvent(input$start_click, ignoreInit = TRUE, {
append_log("START: clearing interrupt and starting chunked loop")
running(TRUE)
run_loop(i = 1L, start_time = Sys.time())
})
}
shinyApp(ui, server)
