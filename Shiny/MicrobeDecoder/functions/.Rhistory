plot_treemap <- function(df, title = NULL, max_colors = 8,
hovertemplate = "<b>X: %{x}</b><br><b>Y: %{y}</b><br><extra></extra>",
coord_fixed = FALSE, x_to_y_ratio = 1) {
if (nrow(df) == 0) {
return(plot_message(message = "No predictions"))
}
df$y <- sapply(df$y, pad_to_length, target_length = 10)
num_colors <- min(nrow(df), max_colors)
colors <- colorspace::rainbow_hcl(num_colors)
df$color <- rep(colors, length.out = nrow(df))
plot <- plotly::plot_ly() %>%
plotly::add_trace(
type = 'treemap',
ids = df$y,
labels = df$y,
parents = "",
values = df$z,
textinfo = 'label',
hovertemplate = hovertemplate,
marker = list(colors = df$color, line = list(width = 2, color = 'black')),
insidetextfont = list(size = 40),
outsidetextfont = list(size = 0),
textposition = 'middle center',
tiling = list(pad = 0)
)
axis_settings = generate_axis_settings()
plot <- plot %>%
plotly::layout(
title = title,
xaxis = axis_settings$xaxis,
yaxis = axis_settings$yaxis,
paper_bgcolor = 'rgba(0,0,0,0)',
plot_bgcolor = 'rgba(0,0,0,0)'
) %>%
# Suppress hover border on root node (cosmetic fix)
# The root node spans the full plot and shows a black rectangle on hover.
# This MutationObserver detects it by bounding box size and hides it.
htmlwidgets::onRender("
function(el) {
var obs = new MutationObserver(function() {
var plotW = el.offsetWidth;
var plotH = el.offsetHeight;
el.querySelectorAll('svg path').forEach(function(p) {
var bb = p.getBoundingClientRect();
if (bb.width > plotW * 0.85 && bb.height > plotH * 0.85) {
p.style.stroke = 'none';
p.style.fill   = 'none';
}
});
});
obs.observe(el, {subtree: true, attributes: true,
attributeFilter: ['style', 'd']});
}
")
return(plot)
}
library(plotly)
library(htmlwidgets)
library(colorspace)
df <- data.frame(
y = c("Fermentation", "Respiration", "Photosynthesis", "Nitrogen fix"),
z = c(35, 28, 20, 17)
)
colors <- colorspace::rainbow_hcl(nrow(df))
plot <- plotly::plot_ly() %>%
plotly::add_trace(
type        = 'treemap',
ids         = df$y,
labels      = df$y,
parents     = "",
values      = df$z,
textinfo    = 'label',
marker      = list(colors = colors, line = list(width = 2, color = 'black')),
textposition = 'middle center',
tiling      = list(pad = 0)
) %>%
plotly::layout(
paper_bgcolor = 'rgba(0,0,0,0)',
plot_bgcolor  = 'rgba(0,0,0,0)'
) %>%
htmlwidgets::onRender("
function(el) {
var obs = new MutationObserver(function() {
var plotW = el.offsetWidth;
var plotH = el.offsetHeight;
el.querySelectorAll('svg path').forEach(function(p) {
var bb = p.getBoundingClientRect();
if (bb.width > plotW * 0.85 && bb.height > plotH * 0.85) {
p.style.stroke = 'none';
p.style.fill   = 'none';
}
});
});
obs.observe(el, {subtree: true, attributes: true,
attributeFilter: ['style', 'd']});
}
")
print(plot)
