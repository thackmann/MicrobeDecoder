# store state in session$userData
session$userData$logText <- reactiveVal("Ready. Press Start.\n")
session$userData$running <- reactiveVal(FALSE)
output$log <- renderText(session$userData$logText())
run_loop <- function(i = 1L, t0 = Sys.time()) {
if (!isTRUE(isolate(session$userData$running()))) return(invisible())
if (check_interrupt(session, i, t0)) return(invisible())
session$userData$logText(
paste0(isolate(session$userData$logText()), "Iter ", i, "\n")
)
later::later(function() run_loop(i + 1L, t0), delay = 0.2)
}
observeEvent(input$start_click, ignoreInit = TRUE, {
session$userData$logText("Running…\n")
session$userData$running(TRUE)
run_loop(1L, Sys.time())
})
}
