elapsed <- round(as.numeric(difftime(Sys.time(), t0, units = "secs")), 2)
logText(paste0(isolate(logText()), "Stopped at iter ", i, " (", elapsed, " s)\n"))
running(FALSE)
return(TRUE)
}
FALSE
}
