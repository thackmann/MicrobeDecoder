# Example R code for testing relationships between methane production
# and abundance of a biological function, while accounting for repeated
# measures within Subject.
# Expected columns in df:
# Subject     = cow, fermentor, or calf ID
# Time        = sampling time (numeric or ordered factor)
# Treatment   = treatment group
# Methane     = methane production (mol/d)
# Abundance   = relative abundance of the function, microbe, or gene
# Example structure:
df <- data.frame(
Subject = c("Cow1","Cow1","Cow1","Cow2","Cow2","Cow2"),
Time = c(1,2,3,1,2,3),
Treatment = c("Control","Control","Control","Bovaer","Bovaer","Bovaer"),
Methane = c(10.2, 9.8, 9.5, 8.1, 7.4, 7.0),
Abundance = c(0.12, 0.15, 0.18, 0.20, 0.24, 0.27)
)
# Convert variables to appropriate classes
df$Subject <- as.factor(df$Subject)
df$Treatment <- as.factor(df$Treatment)
# If Time is categorical:
# df$Time <- as.factor(df$Time)
# If Time is quantitative and equally spaced, keep it numeric:
df$Time <- as.numeric(df$Time)
# ------------------------------------------------------------
# 1. Simple correlation (ignores repeated measures)
# ------------------------------------------------------------
stats::cor.test(
x = df$Abundance,
y = df$Methane,
method = "pearson"
)
# Or Spearman, if the relationship is not linear or data are not normal:
stats::cor.test(
x = df$Abundance,
y = df$Methane,
method = "spearman"
)
# ------------------------------------------------------------
# 2. Simple linear regression (ignores repeated measures)
# ------------------------------------------------------------
model_lm <- stats::lm(
Methane ~ Abundance,
data = df
)
summary(model_lm)
# ------------------------------------------------------------
# 6. Plot relationship between abundance and methane
# ------------------------------------------------------------
ggplot2::ggplot(
df,
ggplot2::aes(x = Abundance, y = Methane, color = Treatment)
) +
ggplot2::geom_point() +
ggplot2::geom_smooth(method = "lm", se = TRUE) +
ggplot2::facet_wrap(~ Time) +
ggplot2::labs(
x = "Relative abundance",
y = "Methane production (mol/d)"
) +
ggplot2::theme_bw()
