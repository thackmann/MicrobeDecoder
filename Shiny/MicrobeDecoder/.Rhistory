"))
),
titlePanel("Shiny Disconnect Redirect Demo"),
sidebarLayout(
sidebarPanel(
h4("Test the Disconnect Redirect"),
p("Click the button below to simulate a server crash/disconnect."),
actionButton("crash", "Crash Server", class = "btn-danger"),
hr(),
p("When you click the button, the server will stop and after 1 second
you'll be redirected to goodbye.html")
),
mainPanel(
h3("Welcome to the App"),
p("This is a simple demonstration of handling Shiny disconnects."),
textOutput("status"),
hr(),
h4("Live Counter"),
p("This counter updates every second to show the app is running:"),
textOutput("counter")
)
)
)
server <- function(input, output, session) {
# Status message
output$status <- renderText({
"Server is running normally..."
})
# Live counter to show the app is active
counter <- reactiveVal(0)
observe({
invalidateLater(1000)
counter(counter() + 1)
})
output$counter <- renderText({
paste("Count:", counter())
})
# Crash button - stops the R session
observeEvent(input$crash, {
showModal(modalDialog(
title = "Crashing Server...",
"Server will stop in 1 second. You'll be redirected to goodbye.html",
footer = NULL
))
# Stop the session after a brief delay
Sys.sleep(1)
stopApp()
})
# Optional: cleanup on session end
session$onSessionEnded(function() {
cat("Session ended at", as.character(Sys.time()), "\n")
})
}
shinyApp(ui = ui, server = server)
