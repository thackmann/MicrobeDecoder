#' Count unique taxa within a domain at a specified taxonomic rank
#'
#' This function counts the number of unique taxa in a dataset for a given
#' domain (e.g., "Bacteria" or "Archaea") at a specified taxonomic rank.
#' Optionally, it enforces hierarchical consistency by requiring that
#' parent taxonomic levels are non-missing and included in the uniqueness
#' definition.
#'
#' @param df A data frame containing taxonomic data, including a column
#'   named `LPSN_Domain` and other taxonomic rank columns.
#' @param domain A character string specifying the domain to filter by
#'   (e.g., "Bacteria" or "Archaea").
#' @param column A character string specifying the taxonomic rank to count
#'   (e.g., "LPSN_Phylum", "LPSN_Genus", "LPSN_Species").
#' @param parent_cols An optional character vector of parent taxonomic
#'   columns (e.g., c("LPSN_Genus") for species). If provided, rows with
#'   missing values in these columns are excluded, and uniqueness is defined
#'   across both the parent columns and the target column.
#'
#' @return An integer giving the number of unique taxa at the specified rank
#'   within the specified domain.
#'
#' @details
#' - Rows are filtered to the specified domain using `LPSN_Domain`.
#' - Missing values in the target column (and parent columns, if provided)
#'   are excluded.
#' - Taxa are counted using `dplyr::distinct()` to ensure uniqueness.
#' - For ranks like species, including parent columns (e.g., genus) prevents
#'   duplication due to shared epithets (e.g., "coli").
#'
#' @examples
#' # Count bacterial genera
#' count_taxa(data, "Bacteria", "LPSN_Genus", "LPSN_Family")
#'
#' # Count archaeal species (ensuring genus-species uniqueness)
#' count_taxa(data, "Archaea", "LPSN_Species", "LPSN_Genus")
#'
#' @export
count_taxa <- function(df, domain, column, parent_cols = NULL) {
df |>
dplyr::filter(LPSN_Domain == domain) |>
dplyr::filter(!is.na(.data[[column]])) |>
dplyr::filter(if (!is.null(parent_cols)) {
dplyr::if_all(dplyr::all_of(parent_cols), ~ !is.na(.))
} else TRUE) |>
dplyr::distinct(dplyr::across(dplyr::all_of(c(parent_cols, column)))) |>
nrow()
}
# === Get script directory ===
dir <- FileLocator::getCurrentFileLocation()
dir <- dirname(dir)
# === Load external R files ===
setwd(dir)
source("functions//helperFunctions.R", local = TRUE)
# === Load fonts and colors ===
setup_fonts()
colors <- load_custom_colors()
# === Load files ===
# Set directory for input files
dir <- FileLocator::getCurrentFileLocation()
dir <- dirname(dir)
setwd(dir)
# Get files
data <- readr::read_csv("database summary/database.zip")
# === Format files ===
# Phylum
bacteria_phylum <- count_taxa(data, "Bacteria", "LPSN_Phylum")
archaea_phylum  <- count_taxa(data, "Archaea", "LPSN_Phylum")
# Class
bacteria_class <- count_taxa(data, "Bacteria", "LPSN_Class", "LPSN_Phylum")
archaea_class  <- count_taxa(data, "Archaea", "LPSN_Class", "LPSN_Phylum")
# Order
bacteria_order <- count_taxa(data, "Bacteria", "LPSN_Order", "LPSN_Class")
archaea_order  <- count_taxa(data, "Archaea", "LPSN_Order", "LPSN_Class")
# Family
bacteria_family <- count_taxa(data, "Bacteria", "LPSN_Family", "LPSN_Order")
archaea_family  <- count_taxa(data, "Archaea", "LPSN_Family", "LPSN_Order")
# Genus
bacteria_genus <- count_taxa(data, "Bacteria", "LPSN_Genus", "LPSN_Family")
archaea_genus  <- count_taxa(data, "Archaea", "LPSN_Genus", "LPSN_Family")
# Species (IMPORTANT: include genus to avoid "coli" duplication)
bacteria_species <- count_taxa(data, "Bacteria", "LPSN_Species", "LPSN_Genus")
archaea_species  <- count_taxa(data, "Archaea", "LPSN_Species", "LPSN_Genus")
# Strains (just rows per domain)
bacteria_strains <- data |> dplyr::filter(LPSN_Domain == "Bacteria") |> nrow()
archaea_strains  <- data |> dplyr::filter(LPSN_Domain == "Archaea") |> nrow()
table_taxa <- tibble::tibble(
`Taxonomic rank` = c("Phylum", "Class", "Order", "Family", "Genus", "Species", "Strains"),
Bacteria = c(
bacteria_phylum,
bacteria_class,
bacteria_order,
bacteria_family,
bacteria_genus,
bacteria_species,
bacteria_strains
),
Archaea = c(
archaea_phylum,
archaea_class,
archaea_order,
archaea_family,
archaea_genus,
archaea_species,
archaea_strains
)
) |>
dplyr::mutate(Total = Bacteria + Archaea)
table_taxa
# === Export data ===
write.csv(table_taxa, "counts of taxa.csv")
getwd()
# === Export data ===
write.csv(table_taxa, "counts of taxa.csv")
