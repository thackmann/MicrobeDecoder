#Format data
for (i in 1:length(var)) {
df_var[[i]] = df
df_var[[i]] = df_var[[i]] %>%
filter(Trial != 0) %>%
filter(!is.na(Value), Units == var[i]) %>%
group_by(Carbohydrate, Trial, Fermenter, Units) %>%
summarise(
Dilution = mean(Dilution, na.rm = TRUE),
Yield = mean(Value, na.rm = TRUE),
.groups = "drop"  # Override the default grouping behavior
) %>%
mutate(
Carbohydrate = as.factor(Carbohydrate),
Trial = as.factor(Trial),
Inverse_Yield = 1/Yield,
Inverse_Dilution  = 1/Dilution
)
}
#Fit model
for (i in 1:length(var)) {
lme_model <- lme(
# fixed   = Inverse_Yield ~ 0 + Carbohydrate + Inverse_Dilution:Carbohydrate + Trial,
Inverse_Yield ~ Inverse_Dilution * Carbohydrate + Trial,
random = ~ 1 | Fermenter,
data = df_var[[i]])
model[[i]] <- lme_model
}
#Get parameter estimates and standard error
for (i in 1:length(var)) {
