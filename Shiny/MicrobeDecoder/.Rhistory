# emms_Yg[[i]] <- emtrends(model[[i]], var = "(Intercept)", ~ Carbohydrate)
ints <- emmeans(model[[i]], ~ Carbohydrate,
at = list(Inverse_Dilution = 0, Trial = levels(df_var[[i]]$Trial)[1])) |>
as.data.frame()
tcrit <- qt(0.975, df = ints$df)
# Max_yield = 1 / intercept
ints$Max_yield         <- 1 / ints$emmean
ints$SE_Max_yield      <- ints$SE / (ints$emmean^2)                    # delta SE
ints$LCL_Max_yield_del <- ints$Max_yield - tcrit * ints$SE_Max_yield   # 95% CI (delta)
ints$UCL_Max_yield_del <- ints$Max_yield + tcrit * ints$SE_Max_yield
emms_Yg[[i]] <- ints[, c("Carbohydrate",
"Max_yield", "SE_Max_yield",
"LCL_Max_yield_del", "UCL_Max_yield_del",
"emmean","SE","lower.CL","upper.CL","df")]
}
# #Get predicted yield and 95% confidence intervals
for (i in 1:length(var)) {
predictions <- emmeans(
model[[i]],
~ Inverse_Dilution * Carbohydrate,
at = list(Inverse_Dilution = seq(min(df_var[[i]]$Inverse_Dilution), max(df_var[[i]]$Inverse_Dilution), by = 0.01),
Trial = levels(df_var[[i]]$Trial)[1])
)
df_pred[[i]] <- as.data.frame(predictions)
}
# Plot data
for(i in 1:length(var))
{
#Get axis limits
x_min = 0
x_max <- max(df_var[[i]]$Inverse_Dilution, na.rm = TRUE)*1.1
y_min = 0
y_max <- max(df_var[[i]]$Inverse_Yield, na.rm = TRUE)*1.1
# Create plot
plot[[i]] =
# Call ggplot
ggplot() +
#Add confidence intervals
geom_ribbon(data = df_pred[[i]], aes(x = Inverse_Dilution, ymin = lower.CL, ymax = upper.CL, fill = Carbohydrate), alpha = 0.3) +
#Add prediction lines
geom_line(data = df_pred[[i]], aes(x= Inverse_Dilution, y=emmean, color = Carbohydrate), linewidth = 0.5) +
#Plot points
geom_point(data = df_var[[i]], aes(x=Inverse_Dilution, y=Inverse_Yield, color = Carbohydrate, shape = Trial), fill=NA, size = 1, stroke = 0.5, alpha=1) +
# Set axis limits
scale_x_continuous(breaks = seq(x_min, x_max, by = 0.1)) +
ylim(y_min, y_max) +
# Set color, fill, and shape scales
scale_color_manual(values = c("Glucose" = red_color, "Cellulose" = green_color)) +
scale_fill_manual(values = c("Glucose" = red_color, "Cellulose" = green_color)) +
scale_shape_manual(values = c(21, 23, 22)) +
# Set theme
theme(
