fasta_to_dummy_biom <- function(
fasta_path,
biom_out = "study_seqs.biom",
sample_ids = c("Sample1","Sample2"),   # <- two samples
counts = c(1L, 0L),                    # counts per sample
make_ids_unique = TRUE
) {
dna <- Biostrings::readDNAStringSet(fasta_path)
ids <- names(dna)
if (make_ids_unique) ids <- make.unique(ids, sep = "_")
stopifnot(length(sample_ids) == length(counts))
