#################
#Define functions
#################
#' Format a label into scientific notation with options for italicization, bolding, and a superscript "T".
#'
#' @param label A list with components: genus, species, subspecies, strain, and accession.
#' @param highlighted_strain A character string representing the strain to highlight (bolded). Defaults to NULL.
#' @param add_superscript_T Logical. If `TRUE`, adds a superscript "T" to the strain name.
#' @return An expression object with formatted text based on the label components.
#' @examples
#' format_label(list(genus = "Bacillus", species = "subtilis", subspecies = "natto", strain = "12345", accession = "AP1"), highlighted_strain = "12345")
format_label <- function(label, highlighted_strain = NULL, add_superscript_T = TRUE) {
# Deconstruct the label list into individual components
genus <- label$genus
species <- label$species
subspecies <- label$subspecies
strain <- trimws(label$strain)  # Ensure no leading or trailing spaces in strain
accession <- label$accession
# Add superscript "T" to strain if specified
if (add_superscript_T) {
if(strain!="")
{
strain <- bquote(.(strain)^T)
}
}
# Check if strain matches any highlighted strain
is_highlighted <- !is.null(highlighted_strain) && any(grepl(pattern = highlighted_strain, x = strain))
# Format label based on the presence of subspecies and highlighting
if (!is_highlighted) {
if (subspecies == "") {
formatted <- bquote(italic(.(genus)) ~ italic(.(species)) ~ .(strain) ~ "(" * .(accession) * ")")
} else {
formatted <- bquote(italic(.(genus)) ~ italic(.(species)) ~ "subsp." ~ italic(.(subspecies)) ~ .(strain) ~ "(" * .(accession) * ")")
}
} else {
formatted <- bquote(bolditalic(.(genus)) ~ bolditalic(.(species)) ~ bold(.(strain)) ~ "(" * bold(.(accession)) * ")")
}
return(formatted)
}
