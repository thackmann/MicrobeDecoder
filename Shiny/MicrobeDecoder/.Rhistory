library(ape)
library(ggtree)
library(phytools)
library(readr)
library(tidyr)
library(ggplot2)
library(stringr)
library(dplyr)
library(purrr)
#########################
#Load and configure fonts
#########################
#Load fonts
#font_import()
#loadfonts(device = "win")
windowsFonts("Courier New" = windowsFont("Courier New"))
windowsFonts("Arial Narrow" = windowsFont("Arial Narrow"))
windowsFonts("Arial" = windowsFont("Arial"))
######################
#Load and prepare data
######################
##Download data from
##https://data.gtdb.ecogenomic.org/releases/latest/
# Load data
fp = read_tsv("G:\\My Drive\\manuscripts\\2024 new species\\GTDB\\bac120_metadata.tsv.gz")
metadata <- read_tsv("G:\\My Drive\\manuscripts\\2024 new species\\GTDB\\bac120_metadata.tsv.gz")
fp <- paste0("G:\\My Drive\\manuscripts\\2024 new species\\GTDB\\bac120.tree")
tree <- read.tree(fp)
# Define strains and families
strains = c("C1.1", "W3.11")
genera = c("Ruminivibrio", "Ruminomonas")
species = c("firkinsii", "capistranica")
families <- c("Lachnospiraceae", "Porphyromonadaceae")
accessions <- c("GCA_030434875", "GCA_030434245")
taxonomic_columns <- c("Domain", "Phylum", "Class", "Order", "Family", "Genus", "Species")
#Initialize values
plot = vector("list", length(strains))
# Process metadata
metadata_processed <- metadata %>%
dplyr::select(accession, gtdb_taxonomy, gtdb_type_designation_ncbi_taxa_sources,
gtdb_representative, gtdb_type_species_of_genus,
gtdb_type_designation_ncbi_taxa, ncbi_type_material_designation, ncbi_genome_category
) %>%
tidyr::separate(gtdb_taxonomy, into = taxonomic_columns, sep = ";") %>%
dplyr::mutate(across(all_of(taxonomic_columns), ~ str_remove(., "^[a-z]__"))) %>%
dplyr::mutate(Species = word(Species, 2))
i=1
# Process metadata
metadata_filtered <- metadata_processed %>%
dplyr::filter(Family == families[i]) %>%
dplyr::filter(grepl(pattern=accessions[i], x = accession) | (gtdb_type_designation_ncbi_taxa_sources == "LPSN"&gtdb_representative==TRUE))
# Filter tree
taxa_to_keep <- c(metadata_filtered %>% pull(accession))
tree_filtered <- drop.tip(tree, setdiff(tree$tip.label, taxa_to_keep))
# Match metadata with tip labels
idx = match(tree_filtered$tip.label, taxa_to_keep)
metadata_filtered = metadata_filtered[idx,]
# Do additional formatting of metadata
metadata_filtered$Strain = ""
metadata_filtered$Subspecies = ""
idx = which(grepl(pattern=accessions[i], x=metadata_filtered$accession))
metadata_filtered$Genus[idx] = genera[i]
metadata_filtered$Species[idx] = species[i]
metadata_filtered$Strain[idx] = strains[i]
#Format tip labels
#Parse labels from tree
labels <- metadata_filtered %>%
dplyr::select(genus = Genus, species = Species, subspecies = Subspecies, strain = Strain, accession = accession) %>%
pmap(function(genus, species, subspecies, strain, accession) {
list(
genus = genus,
species = species,
subspecies = subspecies,
strain = strain,
accession = accession
)
})
# Applying formatting to each parsed label
formatted_labels <-  lapply(labels, format_label, highlighted_strain = strains[i])
# Assign back to tree tip labels
tree_filtered$tip.label <- formatted_labels
# Reroot at midpoint
tree_filtered <- midpoint.root(tree_filtered)
# Define groups
groups <- list(highlighted_strain = which(grepl(pattern=accessions[i], x = tree_filtered$tip.label)))
tree_filtered <- groupOTU(tree_filtered, groups)
# Specify x-limit (controls width of tree)
if(strains[[i]]=="C1.1")
{
x_max = 0.9
}
if(strains[[i]]=="W3.11")
{
x_max = 0.73
}
# Plot tree
plot[[i]] <- ggtree(tree_filtered, layout = "rectangular", size = 0.1, alpha=1)+
#Add tip labels
geom_tiplab(aes(color=group), size=1.8, parse=TRUE) +
scale_color_manual(values=c(highlighted_strain = "red",`0`="black")) +
#Set x-limit
xlim(0, x_max) +
#Add scale bar
geom_treescale(fontsize=1.8, x=0.7,y=0.5) +
theme(
panel.background = element_rect(fill = "transparent", color = NA),
plot.background = element_rect(fill = "transparent", color = NA),
panel.border = element_blank(),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
legend.key.size = unit(0.5,"line"),
legend.key = element_rect(fill = "transparent",colour = NA),
legend.background = element_rect(fill = "transparent",colour = NA),
legend.position = "none",
legend.title = element_text(family="Arial Narrow", color="black", size="6.5"),
legend.text = element_text(family="Arial Narrow", color="black", size="6.5"),
plot.margin = unit(c(0.2,0.2,0.2,0.2), "cm")
)
