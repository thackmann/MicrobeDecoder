# === Load files ===
# Set directory for input files
dir <- FileLocator::getCurrentFileLocation()
setwd(dir)
library(Biostrings)
library(biomformat)
fasta_to_dummy_biom <- function(
fasta_path,
biom_out = "otu_table.biom",
sample_id = "Sample1",
make_ids_unique = TRUE
) {
# 1) Read sequences & get IDs
dna <- Biostrings::readDNAStringSet(fasta_path)
ids <- names(dna)
# Optional: ensure unique rownames (PICRUSt2 expects unique feature IDs)
if (make_ids_unique) {
ids <- make.unique(ids, sep = "_")
}
# 2) Build a 1-column abundance matrix of ones
mat <- matrix(1L, nrow = length(ids), ncol = 1,
dimnames = list(ids, sample_id))
# 3) Create and write BIOM (JSON v1, which PICRUSt2 accepts)
b <- biomformat::make_biom(data = mat)
biomformat::write_biom(b, biom_out)
message("Wrote BIOM to: ", normalizePath(biom_out))
invisible(biom_out)
}
# --- Use it ---
# Save your FASTA as "dna-sequences.fna", then run:
fasta_to_dummy_biom("dna-sequences.fna", biom_out = "otu_table.biom", sample_id = "Sample1")
getwd()
# --- Use it ---
# Save your FASTA as "dna-sequences.fasta", then run:
fasta_to_dummy_biom("dna-sequences.fasta", biom_out = "otu_table.biom", sample_id = "Sample1")
# --- Use it ---
# Save your FASTA as "study_seqs.fna", then run:
fasta_to_dummy_biom("study_seqs.fna", biom_out = "otu_table.biom", sample_id = "Sample1")
# --- Use it ---
# Save your FASTA as "study_seqs.fna", then run:
fasta_to_dummy_biom("study_seqs.fna", biom_out = "study_seqs.biom", sample_id = "Sample1")
# === Load files ===
# Set directory for input files
dir <- FileLocator::getCurrentFileLocation()
setwd(dir)
library(Biostrings)
library(biomformat)
fasta_to_dummy_biom <- function(
fasta_path,
biom_out = "study_seqs.biom",
sample_ids = c("Sample1","Sample2"),   # <- two samples
counts = c(1L, 0L),                    # counts per sample
make_ids_unique = TRUE
) {
dna <- Biostrings::readDNAStringSet(fasta_path)
ids <- names(dna)
if (make_ids_unique) ids <- make.unique(ids, sep = "_")
stopifnot(length(sample_ids) == length(counts))
mat <- matrix(
counts,
nrow = length(ids),
ncol = length(sample_ids),
byrow = TRUE,
dimnames = list(ids, sample_ids)
)
b <- biomformat::make_biom(data = mat)
biomformat::write_biom(b, biom_out)
message("Wrote BIOM to: ", normalizePath(biom_out))
}
# --- Use it ---
# Save your FASTA as "study_seqs.fna", then run:
fasta_to_dummy_biom("study_seqs.fna", biom_out = "study_seqs.biom", sample_id = "Sample1")
