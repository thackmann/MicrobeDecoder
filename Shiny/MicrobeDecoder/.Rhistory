sequence_file <- file.path(base_path, "data/lpsn_ribosomal_sequences.csv")
phylogeny_file <- file.path(base_path, "data/LPSN_phylogeny.csv")
# === Read in data ===
seq  <- readr::read_csv(phylogeny_file)   # taxonomy / phylogeny
phyl <- readr::read_csv(sequence_file)    # sequences
# Clean up taxonomy table: pick one Genus, drop the duplicate
seq_clean <- seq %>%
dplyr::rename(Genus = Genus...1) %>%   # choose the main Genus column
dplyr::select(-`Genus...13`)           # drop the extra Genus column
# Keep only the columns you actually need from the sequence file
phyl_clean <- phyl %>%
dplyr::select(LPSN_ID, `16S_ribosomal_sequence`)
# ===  Join objects ===
df1 <- seq_clean %>%
dplyr::left_join(phyl_clean, by = "LPSN_ID")
# === Filter for target families / genera ===
seq <- list()
strains = c("C1.1", "W3.11")
for(i in 1:length(strains))
{
df2 <- df1
if(strains[i]=="C1.1")
{
df2 <- df1 %>%
dplyr::filter(
Family %in% c("Lachnospiraceae") |
Genus  %in% c("Clostridium", "Eubacterium")
)
}else if(strains[i]=="W3.11")
{
df2 <- df1 %>%
dplyr::filter(
Family %in% c("Porphyromonadaceae")
)
}
df2 <- df2 %>%
dplyr::filter(
!is.na(`16S_ribosomal_sequence`),
`16S_ribosomal_sequence` != ""
)
dna <- Biostrings::DNAStringSet(df2$`16S_ribosomal_sequence`)
names(dna) <- df$LPSN_ID    # headers
seq[[i]] <- dna
}
# === Export ===
for(i in 1:length(strains))
{
fp <- paste0("data/16S_sequence_relatives_", strains[i], ".fasta")
Biostrings::writeXStringSet(seq[[i]], "output.fasta")
}
