# =========================================
# Iris ML comparison (no workflowsets)
# One split, simple defaults, auto-skip
# =========================================
suppressPackageStartupMessages({
library(tidymodels)
library(discrim)
library(stacks)
library(caret)
})
has <- function(pkg) requireNamespace(pkg, quietly = TRUE)
set.seed(123)
# --- Prepare data ---
# --- Read in data ---
data <- readr::read_csv("G:\\My Drive\\grants and awards\\2025 NIFA Foundational Program (DSFAS)\\R\\other\\anaerobe.csv")
data <- data[, -1]
# --- Subsample data ---
set.seed(123)
frac <- 0.01
n <- ceiling((ncol(data) - 1) * frac)
other_cols <- 2:ncol(data)
keep_cols <- c(1, sample(other_cols, n))
data <- data[, keep_cols]
# ----- data split -----
split <- initial_split(data, strata = Response, prop = 0.8)
train <- training(split)
test  <- testing(split)
# ----- common preprocessing (standardize numeric X) -----
rec <- recipe(Response ~ ., data = train) %>%
step_mutate(Response = factor(Response, levels = c(0, 1), labels = c("No","Yes"))) %>%
step_normalize(all_predictors()) %>%
prep()
x_train <- bake(rec, new_data = NULL)         |> dplyr::select(-Response)
y_train <- bake(rec, new_data = NULL)         |> dplyr::pull(Response)
x_test  <- bake(rec, new_data = test)         |> dplyr::select(-Response)
y_test  <- bake(rec, new_data = test)         |> dplyr::pull(Response)
# Helper to compute metrics from class + prob predictions (uses .pred_* columns)
eval_cls <- function(pred_class, prob_tbl, truth, event_level = "second") {
# find probability columns
prob_cols <- grep("^\\.pred_", names(prob_tbl), value = TRUE)
if (length(prob_cols) < 1) stop("No `.pred_` columns found in `prob_tbl`.")
# align truth to prob column order
lvl_from_probs <- sub("^\\.pred_", "", prob_cols)
truth <- factor(truth, levels = lvl_from_probs)
out <- bind_cols(
tibble(.pred_class = pred_class),
prob_tbl[, prob_cols, drop = FALSE],
tibble(truth = truth)
)
# accuracy always works
acc <- yardstick::accuracy(out, truth = truth, estimate = .pred_class)$.estimate
# log loss: binary vs multiclass
if (length(prob_cols) == 2) {
# choose event class based on event_level
ev_idx <- if (event_level == "second") 2L else 1L
ev_name <- paste0(".pred_", levels(out$truth)[ev_idx])
ll <- yardstick::mn_log_loss(
out, truth = truth, !!sym(ev_name), event_level = event_level
)$.estimate
} else {
# multiclass: pass all prob columns
ll <- yardstick::mn_log_loss(
out, truth = truth, !!!syms(prob_cols)
)$.estimate
}
tibble(accuracy = acc, mn_log_loss = ll)
}
results <- list()
make_cm <- function(pred_class, truth) {
yardstick::conf_mat(
tibble(
truth = factor(truth, levels = levels(truth)),                 # keep original order
estimate = factor(pred_class, levels = levels(truth))          # coerce to same levels
),
truth = truth, estimate = estimate
)
}
cms <- list()
# --- Train models ---
# -------------------------
# 1) Multinomial regression
# -------------------------
if (has("glmnet")) {
mod <- multinom_reg(penalty = 0.01, mixture = 1) %>% set_engine("glmnet")
} else {
mod <- multinom_reg() %>% set_engine("nnet")  # no penalty; ships with R
}
fit <- mod %>% fit_xy(x = x_train, y = y_train)
pred_cls_mnr  <- predict(fit, new_data = x_test)$.pred_class
pred_prob_mnr <- predict(fit, new_data = x_test, type = "prob")
results$multinomial <- eval_cls(pred_cls_mnr, pred_prob_mnr, y_test)
cms$multinomial <- make_cm(pred_cls_mnr, y_test)
# -------------------------
# 2) Decision Tree / Random Forest
# -------------------------
if (has("ranger")) {
mod <- rand_forest(trees = 500, mtry = NULL, min_n = 2) %>%
set_mode("classification") %>% set_engine("ranger")
name <- "random_forest (ranger)"
} else {
mod <- decision_tree(cost_complexity = 0.01, tree_depth = 5, min_n = 2) %>%
set_mode("classification") %>% set_engine("rpart")
name <- "decision_tree (rpart)"
}
fit <- mod %>% fit_xy(x = x_train, y = y_train)
pred_cls_rf  <- predict(fit, new_data = x_test)$.pred_class
pred_prob_rf <- predict(fit, new_data = x_test, type = "prob")
results[[name]] <- eval_cls(pred_cls_rf, pred_prob_rf, y_test)
cms[[name]] <- make_cm(pred_cls_rf, y_test)
# -------------------------
# 3) Gradient Boosting (XGBoost)
# -------------------------
if (has("xgboost")) {
mod <- boost_tree(trees = 300, learn_rate = 0.05, tree_depth = 4) %>%
set_mode("classification") %>% set_engine("xgboost")
fit <- mod %>% fit_xy(x = x_train, y = y_train)
pred_cls_xgb  <- predict(fit, new_data = x_test)$.pred_class
pred_prob_xgb <- predict(fit, new_data = x_test, type = "prob")
results$`xgboost` <- eval_cls(pred_cls_xgb, pred_prob_xgb, y_test)
cms$`xgboost` <- make_cm(pred_cls_xgb, y_test)
}
# -------------------------
# 4) SVM (RBF kernel, kernlab)
# -------------------------
if (has("kernlab")) {
sigma_hat <- kernlab::sigest(as.matrix(x_train))[[1]]
mod <- svm_rbf(cost = 1, rbf_sigma = sigma_hat) %>%
set_mode("classification") %>% set_engine("kernlab")
fit <- mod %>% fit_xy(x = x_train, y = y_train)
pred_cls_svm  <- predict(fit, new_data = x_test)$.pred_class
pred_prob_svm <- predict(fit, new_data = x_test, type = "prob")
results$`svm_rbf` <- eval_cls(pred_cls_svm, pred_prob_svm, y_test)
cms$`svm_rbf` <- make_cm(pred_cls_svm, y_test)
}
# -------------------------
# 5) k-Nearest Neighbors
# -------------------------
if (has("kknn")) {
mod <- nearest_neighbor(neighbors = 7, weight_func = "rectangular", dist_power = 2) %>%
set_mode("classification") %>% set_engine("kknn")
fit <- mod %>% fit_xy(x = x_train, y = y_train)
pred_cls_knn  <- predict(fit, new_data = x_test)$.pred_class
pred_prob_knn <- predict(fit, new_data = x_test, type = "prob")
results$`knn (k=7)` <- eval_cls(pred_cls_knn, pred_prob_knn, y_test)
cms$`knn (k=7)` <- make_cm(pred_cls_knn, y_test)
}
# -------------------------
# 6) Naive Bayes
# -------------------------
if (has("naivebayes")) {
mod <- naive_Bayes(smoothness = 1, Laplace = 0) %>% set_mode("classification") %>% set_engine("naivebayes")
fit <- mod %>% fit_xy(x = x_train, y = y_train)
pred_cls_nb  <- predict(fit, new_data = x_test)$.pred_class
pred_prob_nb <- predict(fit, new_data = x_test, type = "prob")
results$`naive_bayes` <- eval_cls(pred_cls_nb, pred_prob_nb, y_test)
cms$`naive_bayes` <- make_cm(pred_cls_nb, y_test)
}
# ----- leaderboard -----
leaderboard <- dplyr::bind_rows(results, .id = "model") |>
dplyr::arrange(dplyr::desc(accuracy))
print(leaderboard)
print(cms)
# --- Make ensemble predictions
# Helpers to safely gather predictions you created above
get_vec  <- function(name) tryCatch(get(name), error = function(e) NULL)
get_prob <- function(name, col = ".pred_Yes")
tryCatch(get(name)[[col]], error = function(e) NULL)
# Map your saved objects (created earlier) ------------------------------------
pred_cls_map <- list(
rf  = "pred_cls_rf",
xgb = "pred_cls_xgb",
knn = "pred_cls_knn",
mnr = "pred_cls_mnr",
svm = "pred_cls_svm",
nb  = "pred_cls_nb"
)
pred_prob_map <- list(
rf  = "pred_prob_rf",
xgb = "pred_prob_xgb",
knn = "pred_prob_knn",
mnr = "pred_prob_mnr",
svm = "pred_prob_svm",
nb  = "pred_prob_nb"
)
# Build available matrices (works even if some models didn't run)
vote_df <- as.data.frame(Filter(Negate(is.null), lapply(pred_cls_map, get_vec)))
prob_df <- as.data.frame(Filter(Negate(is.null), lapply(pred_prob_map, get_prob)))
# ---------------------------------------------------------------------------
# (1) Majority voting  (HARD VOTE)
# ---------------------------------------------------------------------------
if (ncol(vote_df) > 0) {
# Tie-breaker: if tie, fall back to averaged probabilities if available; else default to "No"
majority_fun <- function(row_i) {
row <- vote_df[row_i, , drop = TRUE]
tab <- table(row)
top <- names(which(tab == max(tab)))
if (length(top) == 1) return(top)
# tie:
if (ncol(prob_df) > 0) {
# if we have probs, pick class by mean prob threshold
p_yes <- if (ncol(prob_df) == 1) prob_df[row_i, 1] else mean(as.numeric(prob_df[row_i, ]), na.rm = TRUE)
return(ifelse(p_yes >= 0.5, "Yes", "No"))
} else {
return("No")
}
}
pred_majority <- factor(vapply(seq_len(nrow(vote_df)), majority_fun, character(1)),
levels = levels(y_test))
acc_majority <- mean(pred_majority == y_test)
cm_majority  <- caret::confusionMatrix(pred_majority, y_test, positive = "Yes")
cat("\n[Ensemble - Majority vote] Accuracy:", round(acc_majority, 4), "\n")
print(cm_majority)
leaderboard <- dplyr::bind_rows(
leaderboard,
tibble::tibble(model = "ensemble (majority)", accuracy = acc_majority,
mn_log_loss = NA_real_)
)
}
# ---------------------------------------------------------------------------
# (2) Averaging (SOFT VOTE): equal & weighted
# ---------------------------------------------------------------------------
if (ncol(prob_df) > 0) {
# Equal-weight mean
p_mean <- rowMeans(prob_df, na.rm = TRUE)
pred_mean <- factor(ifelse(p_mean >= 0.5, "Yes", "No"), levels = levels(y_test))
acc_mean <- mean(pred_mean == y_test)
ll_mean  <- yardstick::mn_log_loss(
tibble::tibble(truth = y_test, .pred_Yes = p_mean), truth, .pred_Yes, event_level = "second"
)$.estimate
cm_mean <- caret::confusionMatrix(pred_mean, y_test, positive = "Yes")
cat("\n[Ensemble - Soft vote (mean)] Accuracy:", round(acc_mean, 4),
" | LogLoss:", round(ll_mean, 4), "\n")
print(cm_mean)
# Weighted by calibration (1 / log-loss) using your leaderboard
name_map <- c(
"random_forest (ranger)" = "rf",
"xgboost"                = "xgb",
"knn (k=7)"              = "knn",
"multinomial"            = "mnr",
"svm_rbf"                = "svm",
"naive_bayes"            = "nb"
)
w_tbl <- leaderboard %>%
dplyr::mutate(id = name_map[model]) %>%
dplyr::filter(!is.na(id), id %in% colnames(prob_df)) %>%
dplyr::transmute(id, w = 1 / pmax(mn_log_loss, 1e-6))
if (nrow(w_tbl) == 0) w_tbl <- tibble::tibble(id = colnames(prob_df), w = 1)
w_tbl$w <- w_tbl$w / sum(w_tbl$w)
# align weights to prob_df column order
W <- w_tbl$w[match(colnames(prob_df), w_tbl$id)]
p_w <- as.numeric(as.matrix(prob_df) %*% matrix(W, ncol = 1))
pred_w <- factor(ifelse(p_w >= 0.5, "Yes", "No"), levels = levels(y_test))
acc_w <- mean(pred_w == y_test)
ll_w  <- yardstick::mn_log_loss(
tibble::tibble(truth = y_test, .pred_Yes = p_w), truth, .pred_Yes, event_level = "second"
)$.estimate
cm_w <- caret::confusionMatrix(pred_w, y_test, positive = "Yes")
cat("\n[Ensemble - Soft vote (weighted)] Accuracy:", round(acc_w, 4),
" | LogLoss:", round(ll_w, 4), "\n")
print(cm_w)
leaderboard <- dplyr::bind_rows(
leaderboard,
tibble::tibble(model = "ensemble (mean)",     accuracy = acc_mean, mn_log_loss = ll_mean),
tibble::tibble(model = "ensemble (weighted)", accuracy = acc_w,    mn_log_loss = ll_w)
)
}
# -----------------------------------------
# (3) Stacking (meta-learner) with `stacks`
# -----------------------------------------
if (requireNamespace("stacks", quietly = TRUE)) {
# 1) Make factor copies for stacking
train_s <- dplyr::mutate(train, Response = factor(Response, levels = c(0, 1), labels = c("No", "Yes")))
test_s  <- dplyr::mutate(test,  Response = factor(Response, levels = c(0, 1), labels = c("No", "Yes")))
# 2) Recipe WITHOUT touching the outcome
rec0 <- recipe(Response ~ ., data = train_s) %>%
step_zv(all_predictors()) %>%
step_normalize(all_predictors())
# 3) CV folds based on the factorized data
folds <- vfold_cv(train_s, v = 5, strata = Response)
# 4) Model specs & workflows (guard by availability)
wf_list <- list()
if (has("ranger")) {
rf_spec  <- rand_forest(trees = 500) %>% set_mode("classification") %>% set_engine("ranger")
wf_list$rf  <- workflow() %>% add_model(rf_spec)  %>% add_recipe(rec0)
}
if (has("xgboost")) {
xgb_spec <- boost_tree(trees = 300, learn_rate = 0.05, tree_depth = 4) %>% set_mode("classification") %>% set_engine("xgboost")
wf_list$xgb <- workflow() %>% add_model(xgb_spec) %>% add_recipe(rec0)
}
mnr_spec <- if (has("glmnet")) multinom_reg(penalty = 0.01, mixture = 1) %>% set_engine("glmnet")
else                multinom_reg() %>% set_engine("nnet")
wf_list$mnr <- workflow() %>% add_model(mnr_spec) %>% add_recipe(rec0)
if (has("kknn")) {
knn_spec <- nearest_neighbor(neighbors = 7) %>% set_mode("classification") %>% set_engine("kknn")
wf_list$knn <- workflow() %>% add_model(knn_spec) %>% add_recipe(rec0)
}
# 5) Resample: save preds + workflow for stacks
stack_metrics <- metric_set(accuracy, mn_log_loss)
ctrl <- control_resamples(save_pred = TRUE, save_workflow = TRUE)
rs_list <- lapply(wf_list, function(wf) {
# use train_s here so the recipe sees factor outcome
fit_resamples(wf, folds, metrics = stack_metrics, control = ctrl)
})
# 6) Build & fit the stack (explicit candidate names)
stk <- stacks()
for (nm in names(rs_list)) {
stk <- add_candidates(stk, rs_list[[nm]], name = nm)
}
stk <- blend_predictions(stk, metric = metric_set(mn_log_loss)) %>%  # or accuracy
fit_members()
# 7) Predict on the (factorized) test data
stack_prob <- predict(stk, new_data = test_s, type = "prob")
stack_cls  <- predict(stk, new_data = test_s, type = "class")$.pred_class
# 8) Evaluate against your y_test (already factor No/Yes)
acc_stack <- mean(stack_cls == y_test)
ll_stack  <- yardstick::mn_log_loss(
dplyr::bind_cols(stack_prob, truth = y_test), truth, .pred_Yes, event_level = "second"
)$.estimate
cat("\n[Ensemble - Stacking (stacks)] Accuracy:", round(acc_stack, 4),
" | LogLoss:", round(ll_stack, 4), "\n")
print(caret::confusionMatrix(stack_cls, y_test, positive = "Yes"))
leaderboard <- dplyr::bind_rows(
leaderboard,
tibble::tibble(model = "stack (stacks)", accuracy = acc_stack, mn_log_loss = ll_stack)
)
}
# ---- Final combined leaderboard with ensembles ----
leaderboard <- leaderboard %>% dplyr::arrange(dplyr::desc(accuracy))
cat("\n==== Combined leaderboard (models + ensembles) ====\n")
print(leaderboard)
