p_yes <- if (ncol(prob_df) == 1) prob_df[row_i, 1] else mean(as.numeric(prob_df[row_i, ]), na.rm = TRUE)
return(ifelse(p_yes >= 0.5, "Yes", "No"))
} else {
return("No")
}
}
pred_majority <- factor(vapply(seq_len(nrow(vote_df)), majority_fun, character(1)),
levels = levels(y_test))
acc_majority <- mean(pred_majority == y_test)
cm_majority  <- caret::confusionMatrix(pred_majority, y_test, positive = "Yes")
cat("\n[Ensemble - Majority vote] Accuracy:", round(acc_majority, 4), "\n")
print(cm_majority)
leaderboard <- dplyr::bind_rows(
leaderboard,
tibble::tibble(model = "ensemble (majority)", accuracy = acc_majority,
mn_log_loss = NA_real_)
)
}
# ---------------------------------------------------------------------------
# (2) Averaging (SOFT VOTE): equal & weighted
# ---------------------------------------------------------------------------
if (ncol(prob_df) > 0) {
# Equal-weight mean
p_mean <- rowMeans(prob_df, na.rm = TRUE)
pred_mean <- factor(ifelse(p_mean >= 0.5, "Yes", "No"), levels = levels(y_test))
acc_mean <- mean(pred_mean == y_test)
ll_mean  <- yardstick::mn_log_loss(
tibble::tibble(truth = y_test, .pred_Yes = p_mean), truth, .pred_Yes, event_level = "second"
)$.estimate
cm_mean <- caret::confusionMatrix(pred_mean, y_test, positive = "Yes")
cat("\n[Ensemble - Soft vote (mean)] Accuracy:", round(acc_mean, 4),
" | LogLoss:", round(ll_mean, 4), "\n")
print(cm_mean)
# Weighted by calibration (1 / log-loss) using your leaderboard
name_map <- c(
"random_forest (ranger)" = "rf",
"xgboost"                = "xgb",
"knn (k=7)"              = "knn",
"multinomial"            = "mnr",
"svm_rbf"                = "svm",
"naive_bayes"            = "nb"
)
w_tbl <- leaderboard %>%
dplyr::mutate(id = name_map[model]) %>%
dplyr::filter(!is.na(id), id %in% colnames(prob_df)) %>%
dplyr::transmute(id, w = 1 / pmax(mn_log_loss, 1e-6))
if (nrow(w_tbl) == 0) w_tbl <- tibble::tibble(id = colnames(prob_df), w = 1)
w_tbl$w <- w_tbl$w / sum(w_tbl$w)
# align weights to prob_df column order
W <- w_tbl$w[match(colnames(prob_df), w_tbl$id)]
p_w <- as.numeric(as.matrix(prob_df) %*% matrix(W, ncol = 1))
pred_w <- factor(ifelse(p_w >= 0.5, "Yes", "No"), levels = levels(y_test))
acc_w <- mean(pred_w == y_test)
ll_w  <- yardstick::mn_log_loss(
tibble::tibble(truth = y_test, .pred_Yes = p_w), truth, .pred_Yes, event_level = "second"
)$.estimate
cm_w <- caret::confusionMatrix(pred_w, y_test, positive = "Yes")
cat("\n[Ensemble - Soft vote (weighted)] Accuracy:", round(acc_w, 4),
" | LogLoss:", round(ll_w, 4), "\n")
print(cm_w)
leaderboard <- dplyr::bind_rows(
leaderboard,
tibble::tibble(model = "ensemble (mean)",     accuracy = acc_mean, mn_log_loss = ll_mean),
tibble::tibble(model = "ensemble (weighted)", accuracy = acc_w,    mn_log_loss = ll_w)
)
}
# -----------------------------------------
# (3) Stacking (meta-learner) with `stacks`
# -----------------------------------------
if (requireNamespace("stacks", quietly = TRUE)) {
# 1) Make factor copies for stacking
train_s <- dplyr::mutate(train, Response = factor(Response, levels = c(0, 1), labels = c("No", "Yes")))
test_s  <- dplyr::mutate(test,  Response = factor(Response, levels = c(0, 1), labels = c("No", "Yes")))
# 2) Recipe WITHOUT touching the outcome
rec0 <- recipe(Response ~ ., data = train_s) %>%
step_zv(all_predictors()) %>%
step_normalize(all_predictors())
# 3) CV folds based on the factorized data
folds <- vfold_cv(train_s, v = 5, strata = Response)
# 4) Model specs & workflows (guard by availability)
wf_list <- list()
if (has("ranger")) {
rf_spec  <- rand_forest(trees = 500) %>% set_mode("classification") %>% set_engine("ranger")
wf_list$rf  <- workflow() %>% add_model(rf_spec)  %>% add_recipe(rec0)
}
if (has("xgboost")) {
xgb_spec <- boost_tree(trees = 300, learn_rate = 0.05, tree_depth = 4) %>% set_mode("classification") %>% set_engine("xgboost")
wf_list$xgb <- workflow() %>% add_model(xgb_spec) %>% add_recipe(rec0)
}
mnr_spec <- if (has("glmnet")) multinom_reg(penalty = 0.01, mixture = 1) %>% set_engine("glmnet")
else                multinom_reg() %>% set_engine("nnet")
wf_list$mnr <- workflow() %>% add_model(mnr_spec) %>% add_recipe(rec0)
if (has("kknn")) {
knn_spec <- nearest_neighbor(neighbors = 7) %>% set_mode("classification") %>% set_engine("kknn")
wf_list$knn <- workflow() %>% add_model(knn_spec) %>% add_recipe(rec0)
}
# 5) Resample: save preds + workflow for stacks
stack_metrics <- metric_set(accuracy, mn_log_loss)
ctrl <- control_resamples(save_pred = TRUE, save_workflow = TRUE)
rs_list <- lapply(wf_list, function(wf) {
# use train_s here so the recipe sees factor outcome
fit_resamples(wf, folds, metrics = stack_metrics, control = ctrl)
})
# 6) Build & fit the stack (explicit candidate names)
stk <- stacks()
for (nm in names(rs_list)) {
stk <- add_candidates(stk, rs_list[[nm]], name = nm)
}
stk <- blend_predictions(stk, metric = metric_set(mn_log_loss)) %>%  # or accuracy
fit_members()
# 7) Predict on the (factorized) test data
stack_prob <- predict(stk, new_data = test_s, type = "prob")
stack_cls  <- predict(stk, new_data = test_s, type = "class")$.pred_class
# 8) Evaluate against your y_test (already factor No/Yes)
acc_stack <- mean(stack_cls == y_test)
ll_stack  <- yardstick::mn_log_loss(
dplyr::bind_cols(stack_prob, truth = y_test), truth, .pred_Yes, event_level = "second"
)$.estimate
cat("\n[Ensemble - Stacking (stacks)] Accuracy:", round(acc_stack, 4),
" | LogLoss:", round(ll_stack, 4), "\n")
print(caret::confusionMatrix(stack_cls, y_test, positive = "Yes"))
leaderboard <- dplyr::bind_rows(
leaderboard,
tibble::tibble(model = "stack (stacks)", accuracy = acc_stack, mn_log_loss = ll_stack)
)
}
# ---- Final combined leaderboard with ensembles ----
leaderboard <- leaderboard %>% dplyr::arrange(dplyr::desc(accuracy))
cat("\n==== Combined leaderboard (models + ensembles) ====\n")
print(leaderboard)
