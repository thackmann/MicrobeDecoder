metadata_filtered$Subspecies = ""
idx = which(grepl(pattern=accessions[i], x=metadata_filtered$accession))
metadata_filtered$Genus[idx] = genera[i]
metadata_filtered$Species[idx] = species[i]
metadata_filtered$Strain[idx] = strains[i]
#Format tip labels
#Parse labels from tree
labels <- metadata_filtered %>%
dplyr::select(genus = Genus, species = Species, subspecies = Subspecies, strain = Strain, accession = accession) %>%
pmap(function(genus, species, subspecies, strain, accession) {
list(
genus = genus,
species = species,
subspecies = subspecies,
strain = strain,
accession = accession
)
})
# Applying formatting to each parsed label
formatted_labels <-  lapply(labels, format_label, highlighted_strain = strains[i])
# Assign back to tree tip labels
tree_filtered$tip.label <- formatted_labels
# Reroot at midpoint
tree_filtered <- midpoint.root(tree_filtered)
# Define groups
groups <- list(highlighted_strain = which(grepl(pattern=accessions[i], x = tree_filtered$tip.label)))
tree_filtered <- groupOTU(tree_filtered, groups)
# Specify x-limit (controls width of tree)
if(strains[[i]]=="C1.1")
{
x_max = 0.9
}
if(strains[[i]]=="W3.11")
{
x_max = 0.73
}
# Plot tree
plot[[i]] <- ggtree(tree_filtered, layout = "rectangular", size = 0.1, alpha=1)+
#Add tip labels
geom_tiplab(aes(color=group), size=1.8, parse=TRUE) +
scale_color_manual(values=c(highlighted_strain = "red",`0`="black")) +
#Set x-limit
xlim(0, x_max) +
#Add scale bar
geom_treescale(fontsize=1.8, x=0.7,y=0.5) +
theme(
panel.background = element_rect(fill = "transparent", color = NA),
plot.background = element_rect(fill = "transparent", color = NA),
panel.border = element_blank(),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
legend.key.size = unit(0.5,"line"),
legend.key = element_rect(fill = "transparent",colour = NA),
legend.background = element_rect(fill = "transparent",colour = NA),
legend.position = "none",
legend.title = element_text(family="Arial Narrow", color="black", size=6.5),
legend.text = element_text(family="Arial Narrow", color="black", size=6.5),
plot.margin = unit(c(0.2,0.2,0.2,0.2), "cm")
)
plot[[i]]
